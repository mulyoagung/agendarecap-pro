<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/consultation_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1C1C1E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/consultation_widget_title"
            android:text="AGENDARECAP PRO"
            android:textColor="#F97316"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konsultasi"
            android:textColor="#A1A1AA"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Count Badge + Add Note Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/consultation_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#F97316"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingEnd="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="konsultasi aktif"
            android:textColor="#A1A1AA"
            android:textSize="10sp" />

        <!-- Tambah Catatan Button -->
        <TextView
            android:id="@+id/consultation_btn_add_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Catatan"
            android:textColor="#F97316"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#2A1810"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Scrollable ListView for Consultation Items -->
    <ListView
        android:id="@+id/consultation_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="2dp"
        android:overScrollMode="never" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/consultation_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tidak ada konsultasi aktif"
        android:textColor="#71717A"
        android:textSize="11sp"
        android:visibility="gone"
        android:paddingTop="8dp" />

</LinearLayout>
